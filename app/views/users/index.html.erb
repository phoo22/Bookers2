<div class="container px-5 px-sm-0">
  <div class="row">
    <div class="col-md-3">
      <h2>User info</h2>
      <%= image_tag Current.user.get_profile_image(100, 100) %>

      <table class="table">
        <tr>
          <th>Name</th>
          <td><%= Current.user.name %></td>
        </tr>

        <tr>
          <th class="border-0">Introduction</th>
          <td class="border-0"><%= Current.user.introduction %></td>
        </tr>
      </table>

      <%= link_to edit_user_path(Current.user), class: "btn btn-outline-secondary btn-block w-100" do %>
        <i class="fa-solid fa-user-gear"></i>
      <% end %>

      <h2>New book</h2>

      <%= form_with model: @book do |f| %>
        <div>
          <%= f.label :title, "Title" %>
          <%= f.text_field :title, class: "form-control" %>
        </div>

        <div>
          <%= f.label :body, "Opinion" %>
          <%= f.text_area :body, class: "form-control" %>
        </div>

        <%= f.submit "Create Book", class: "btn btn-success" %>
      <% end %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Users</h2>
      <table class="table">
        <thead>
          <tr class="border-top">
            <th>image</th>
            <th>name</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <%= image_tag user.get_profile_image(100, 100) %>
              </td>
              <td>
                <%= user.name %>
              </td>
              <td>
                <%= link_to "Show", user_path(user) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>