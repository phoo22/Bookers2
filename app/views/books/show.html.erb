<div class="container px-5 px-sm-0 mt-4">
  <div class="row">

    <div class="col-md-3">
      <%= render "users/info", user: @user, book: @book_new %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2 class="border-bottom">Book detail</h2>

      <table class="table">
        <tbody>
          <tr>
            <td>
              <%= link_to user_path(@book.user), class: "custom-book-link" do %>
                <%= image_tag @book.user.get_profile_image(100, 100) %><br>
                <%= @book.user.name %>
              <% end %>
            </td>

            <td>
              <%= link_to @book.title, book_path(@book), class: "custom-book-link" %>
            </td>

            <td>
              <%= @book.body %>
            </td>

            <% if @book.user == Current.user %>
              <td>
                <%= link_to "Edit",
                            edit_book_path(@book),
                            class: "btn btn-sm btn-success" %>
              </td>

              <td>
                <%= link_to "Destroy",
                            book_path(@book),
                            data: {
                              turbo_method: :delete,
                              turbo_confirm: "本当に消しますか?"
                            },
                            class: "btn btn-sm btn-danger" %>
              </td>
            <% end %>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</div>