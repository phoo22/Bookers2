<div class="container mt-4">
  <div class="row">
    <div class="col-md-6 offset-md-3">

      <h1>Editing Book</h1>

      <% if @book.errors.any? %>
        <div id="error_explanation">
          <h3>
            <%= pluralize(@book.errors.count, "error") %>
            prohibited this book from being saved:
          </h3>

          <ul>
            <% @book.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @book do |f| %>

        <div class="mb-3">
          <%= f.label :title, "Title" %>
          <%= f.text_field :title, class: "form-control", style: "font-size: 18px; letter-spacing: 1px;" %>
        </div>

        <div class="mb-3">
          <%= f.label :body, "Opinion" %>
          <%= f.text_area :body, class: "form-control", style: "font-size: 18px; letter-spacing: 1px;" %>
        </div>

        <%= f.submit "Update Book", class: "btn btn-success" %>

      <% end %>

      <div class="mt-3">
        <%= link_to "Show", book_path(@book), class: "book-link" %>
        |
        <%= link_to "Back", books_path, class: "book-link" %>
      </div>

    </div>
  </div>
</div>