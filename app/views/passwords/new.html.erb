<div class="container">
  <div class="row">
    <div class="col-md-6 mx-auto">

      <h1>Forgot your password?</h1>

      <%= form_with url: passwords_path, method: :post do |form| %>
        <div class="mb-3">
          <%= form.label :email, "Email" %>
          <%= form.email_field :email, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.submit "Send me reset password instructions",
                class: "btn btn-secondary w-100" %>
        </div>
      <% end %>

      <div class="mt-3">
        <%= link_to "Log in", login_path, class: "text-decoration-none"%>
      </div>

      <div class="mt-2">
        <%= link_to "Sign up", new_user_path, class: "text-decoration-none" %>
      </div>

    </div>
  </div>
</div>